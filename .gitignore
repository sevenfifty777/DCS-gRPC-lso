# Built binaries and locally recorded passes never belong in source control:
# the release binary is published on GitHub Releases, and recorded passes
# carry real pilot callsigns and a SQLite file. Test fixtures live in
# tests/recordings/ instead.
/releases/
/trap sample/
/tools/aoa_calibration/recovery_aoa_calibration*

# Local launch scripts carry the Discord webhook and machine-specific paths.
# Keep them untracked; read the webhook from the environment (see
# docs/ADMIN_GUIDE.md).
/run-live*.ps1
/run-*.ps1
# Site-specific baseline manifest (mission hash, deployed DLL/Lua hashes); the
# template is docs/BASELINE_MANIFEST.example.json.
/live-baseline.json

